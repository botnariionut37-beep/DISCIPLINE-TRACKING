rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the caller is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Isolated user document storing habit categories, weekly checks, and ranks
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // Public community leaderboard entries
    match /leaderboard/{userId} {
      // Allow reading if the entry is marked public OR if the user owns it
      allow read: if resource == null || resource.data.isPublic == true || isOwner(userId);
      // Only the authenticated user can create or update their own leaderboard document
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
